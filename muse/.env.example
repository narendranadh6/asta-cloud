# Copy to .env and fill in. Never commit .env.

MUSE_ENVIRONMENT=development
MUSE_DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production (32+ chars). Leave unset locally to use an insecure dev default.
# MUSE_JWT_SECRET=

# Database / cache (docker-compose overrides these for the api container)
MUSE_DATABASE_URL=postgresql+asyncpg://muse:muse@localhost:5432/muse
MUSE_REDIS_URL=redis://localhost:6379/0

# YouTube Data API v3 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
# "mock" serves a clearly labelled demo catalog and needs no key.
MUSE_YOUTUBE_PROVIDER=mock
MUSE_YOUTUBE_API_KEY=
MUSE_YOUTUBE_REGION_CODE=US

# Optional LLM planner: none | anthropic | openai (OpenAI-compatible endpoints)
# Without a key MUSE uses its deterministic planner.
MUSE_LLM_PROVIDER=none
MUSE_LLM_API_KEY=
MUSE_LLM_MODEL=claude-sonnet-5-5
# MUSE_LLM_BASE_URL=

# Rate limits per minute
MUSE_RATE_LIMIT_SEARCH_PER_MINUTE=30
MUSE_RATE_LIMIT_AI_PER_MINUTE=6
