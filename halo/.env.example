# Copy to .env and fill in. Never commit .env.

HALO_ENVIRONMENT=development
HALO_DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production (32+ chars). Leave unset locally to use an insecure dev default.
# HALO_JWT_SECRET=

# Database / cache (docker-compose overrides these for the api container)
HALO_DATABASE_URL=postgresql+asyncpg://halo:halo@localhost:5432/halo
HALO_REDIS_URL=redis://localhost:6379/0

# YouTube Data API v3 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
HALO_YOUTUBE_API_KEY=
HALO_YOUTUBE_REGION_CODE=US

# Optional open music data for recommendations
HALO_LASTFM_API_KEY=
HALO_DEEZER_ENABLED=true
# MusicBrainz (canonical metadata) and ListenBrainz (discovery). No key needed.
HALO_MUSICBRAINZ_ENABLED=true
HALO_MUSICBRAINZ_CONTACT=https://github.com/narendranadh6/asta-cloud
HALO_LISTENBRAINZ_ENABLED=true
# Optional: unlocks per-artist popularity (listenbrainz.org/settings)
HALO_LISTENBRAINZ_TOKEN=
HALO_LISTENBRAINZ_TRACK_LOOKUPS=4

# Optional LLM planner: none | anthropic | openai (OpenAI-compatible endpoints)
# Without a key Halo uses its deterministic planner.
HALO_LLM_PROVIDER=none
HALO_LLM_API_KEY=
HALO_LLM_MODEL=claude-sonnet-5-5
# HALO_LLM_BASE_URL=

# Rate limits per minute
HALO_RATE_LIMIT_SEARCH_PER_MINUTE=30
HALO_RATE_LIMIT_AI_PER_MINUTE=6
